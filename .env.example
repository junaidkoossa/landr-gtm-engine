# "claude", "gemini" (small test runs only; live scoring, no batches) or "ollama" (a free
# model on this computer; live scoring). If left blank, Gemini is used when only
# GEMINI_API_KEY is set, and Claude otherwise.
SCORING_PROVIDER=

# Required for Claude scoring, and for Claude hooks when scoring with Ollama.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: scoring models. Live and batch runs both default to claude-sonnet-5-5.
CLAUDE_MODEL=
CLAUDE_BATCH_MODEL=

# Required for Gemini scoring (key from https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional: defaults to gemini-3.8-flash.
GEMINI_MODEL=
# Optional: tried when GEMINI_MODEL stays busy; defaults to gemini-3.5-flash-lite, "none" turns it off.
GEMINI_FALLBACK_MODEL=

# Ollama scoring (no key). Defaults: http://localhost:11434 and llama3.1:8b.
OLLAMA_HOST=
OLLAMA_MODEL=

# Who writes the outreach hook: "same" (the scoring model, for every creator; the default
# for Claude and Gemini), "claude" (Claude, only for creators scoring HOOK_MIN_SCORE or
# more; the default for Ollama, needs ANTHROPIC_API_KEY) or "none".
HOOK_PROVIDER=
# Optional: defaults to 7.
HOOK_MIN_SCORE=

# Required when the input has YouTube channel URLs (free key from Google Cloud).
YOUTUBE_API_KEY=
# Optional: adds Discogs data for labels (free personal access token).
DISCOGS_TOKEN=
# Recommended: a URL or email MusicBrainz and Discogs can reach you at; sent in the User-Agent.
DATA_SOURCE_CONTACT=

# Instagram Business Discovery: a long-lived token and your own professional account's ID.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
# TikTok through Bright Data (billed per record after the free allowance).
BRIGHTDATA_API_TOKEN=

ACTIVATION_WEBHOOK_URL=
# "clay" (one creator per request, the default) or "batched" (100 creators per request).
ACTIVATION_WEBHOOK_FORMAT=clay

# HubSpot private app token (scopes: crm.objects.contacts.write, crm.schemas.contacts.write).
# Leave blank to skip HubSpot. Contacts need an "email" column in the input CSV.
HUBSPOT_ACCESS_TOKEN=
